# ==========================================
# SAPAR ERP — Root Git Ignore Configuration
# Security & Secret Sanitization
# ==========================================

# Environment & Secrets (STRICT - NEVER COMMIT)
.env
.env.*
!.env.example
docker/.env
docker/.env.*
!docker/.env.example
*.local
*.secret
*.secrets
credentials.json
service-account*.json

# Certificates, Digital Signatures & Private Keys
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.pkcs8
*.jks
id_rsa*
id_ed25519*
token.json
session.json

# Dependencies & Package Caches
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Build Outputs & Bundles
dist/
build/
out/
.next/
*.tsbuildinfo

# Database dumps, storage & backups
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db
backups/
storage/uploads/
uploads/
dumps/

# Logs & Debug Data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Subagent Artifacts
.playwright-mcp/
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
.nyc_output/
.system_generated/

# OS and IDE Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
