{
  "info": {
    "_postman_id": "sapar-erp-api-v2-collection",
    "name": "SAPAR ERP — Complete REST API Collection (v2.4.0)",
    "description": "Rasmiy SAPAR ERP Postman to'plami. O'zbekiston va Markaziy Osiyo standartlari bo'yicha 21-BHMS buxgalteriya, Soliq hisobotlari, E-IMZO, Didox, POS kassa, savdo va xarid modullari uchun to'liq API so'rovlar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01. Authentication & Session",
      "item": [
        {
          "name": "Login (Tizimga kirish)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "    console.log(\"Saved JWT token to environment\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"stroy@sapar.uz\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Foydalanuvchi tizimga kiradi va avtomatik ravishda environment token o'zgaruvchisiga JWT tokenini saqlaydi."
          }
        },
        {
          "name": "Register Company Owner (Ro'yxatdan o'tish)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Farhod\",\n  \"lastName\": \"Rahimov\",\n  \"email\": \"stroy@sapar.uz\",\n  \"phone\": \"+998901234567\",\n  \"password\": \"password123\",\n  \"companyName\": \"RIZOBAY STROY OOO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Current User Profile (Foydalanuvchi ma'lumotlari)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        }
      ]
    },
