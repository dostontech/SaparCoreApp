# SAPAR ERP — Backend Environment Configuration
# Copy this file to .env and fill in production values

NODE_ENV=production
PORT=3005

# CORS — Allowed frontend origins (comma-separated). Use specific URLs in production.
CORS_ORIGIN=https://app.sapar.uz

# JWT Authentication Secret (generate with: node -e "require('crypto').randomBytes(32).toString('hex')")
JWT_SECRET=CHANGE_ME_generate_32_char_random_hex

# AES-256-GCM key for encrypting provider API keys at rest (32-byte hex)
AI_ENCRYPTION_KEY=CHANGE_ME_generate_32_char_random_hex

# PostgreSQL Database Connection
POSTGRES_USER=sapar
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=sapar
DATABASE_URL=postgresql://sapar:CHANGE_ME_strong_password@localhost:5432/sapar?schema=public

# Boot Lifecycle Flags (all false in production after first setup)
SEED_ON_BOOT=false
BACKFILL_ON_BOOT=false
GEO_ON_BOOT=false
MIGRATE_ON_BOOT=false

# Set to true ONLY for demo/staging to auto-create demo accounts with password123
# NEVER enable in production — creates hardcoded accounts with weak passwords
DEMO_ACCOUNTS_ON_BOOT=false
